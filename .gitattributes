# Normaliza fim de linha: o repositório guarda LF, independente do sistema de quem commita
* text=auto eol=lf

# Scripts Windows precisam de CRLF para rodar
*.cmd text eol=crlf
*.bat text eol=crlf

# Binários: nunca tentar diff nem converter
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
*.otf binary
*.jar binary
*.apk binary
*.aab binary

# Arquivos gerados: fora do diff do PR e das estatísticas de linguagem
docs/02-arquitetura/der.svg linguist-generated=true -diff
package-lock.json linguist-generated=true -diff
